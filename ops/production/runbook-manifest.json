      "path": "docs/runbooks/execution-stop-worker-loss.md",
      "owner": "execution-platform",
      "escalation": [
        "incident-commander",
        "runtime-quality"
      ],
      "operations": [
        "global-stop",
        "project-stop",
        "worker-loss"
      ]
    },
    {
      "id": "database-object-recovery",
      "title": "数据库与对象存储恢复",
      "path": "docs/runbooks/database-object-recovery.md",
      "owner": "data-platform",
      "escalation": [
        "incident-commander",
        "platform-security"
      ],
      "operations": [
        "database-restore",
        "point-in-time-recovery",
        "object-recovery"
      ]
    },
    {
      "id": "credential-rotation-security-incident",
      "title": "凭证轮换与安全事件",
