# Non-secret deployment identity. Keep these values together.
HARNESS_DEPLOYMENT_ENV=staging
# Non-secret endpoint ID from this environment's Neon hostname (ep-...).
HARNESS_POSTGRES_ENDPOINT_ID=
WORKBENCH_DATA_SOURCE=postgres
WORKBENCH_SCOPE_ID=staging

# Inject AI_DEV_HARNESS_STAGING_DATABASE_URL here at runtime.
DATABASE_URL=
ARTIFACT_STORE_PATH=/var/lib/ai-dev-harness/staging-artifacts
ARTIFACT_OBJECT_STORE=s3
ARTIFACT_S3_REGION=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_PREFIX=staging
ARTIFACT_S3_FORCE_PATH_STYLE=false
CODEX_PLANNER_MODEL=

# Inject the staging OIDC registration and server-only Secrets at runtime.
OIDC_ISSUER=https://idp.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://staging.example.invalid/auth/callback
OIDC_COOKIE_SECRET=
OIDC_ALLOWED_RETURN_TO_PATHS=/,/goals
OIDC_SESSION_TTL_SECONDS=28800
OIDC_TRANSACTION_TTL_SECONDS=600
