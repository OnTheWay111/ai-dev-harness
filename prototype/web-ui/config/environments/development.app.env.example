# Non-secret deployment identity. Keep these values together.
HARNESS_DEPLOYMENT_ENV=development
# Non-secret endpoint ID from this environment's Neon hostname (ep-...).
HARNESS_POSTGRES_ENDPOINT_ID=
WORKBENCH_DATA_SOURCE=postgres
WORKBENCH_SCOPE_ID=development

# Inject AI_DEV_HARNESS_DEVELOPMENT_DATABASE_URL here at runtime.
DATABASE_URL=
ARTIFACT_STORE_PATH=/var/lib/ai-dev-harness/development-artifacts
CODEX_PLANNER_MODEL=

# Inject the development OIDC registration and server-only Secrets at runtime.
OIDC_ISSUER=https://idp.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://development.example.invalid/auth/callback
OIDC_COOKIE_SECRET=
OIDC_ALLOWED_RETURN_TO_PATHS=/,/goals
OIDC_SESSION_TTL_SECONDS=28800
OIDC_TRANSACTION_TTL_SECONDS=600
