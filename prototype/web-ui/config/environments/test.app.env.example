# Non-secret deployment identity. Keep these values together.
HARNESS_DEPLOYMENT_ENV=test
# Non-secret endpoint ID from this environment's Neon hostname (ep-...).
HARNESS_POSTGRES_ENDPOINT_ID=
WORKBENCH_DATA_SOURCE=postgres
WORKBENCH_SCOPE_ID=test

# Inject AI_DEV_HARNESS_TEST_DATABASE_URL here at runtime.
DATABASE_URL=

# Inject the test OIDC registration and server-only Secrets at runtime.
OIDC_ISSUER=https://idp.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://test.example.invalid/auth/callback
OIDC_COOKIE_SECRET=
OIDC_ALLOWED_RETURN_TO_PATHS=/,/goals
OIDC_SESSION_TTL_SECONDS=28800
OIDC_TRANSACTION_TTL_SECONDS=600
