# Local-only defaults. Managed environments use the templates under
# config/environments and must select PostgreSQL explicitly.
WORKBENCH_DATA_SOURCE=auto
WORKBENCH_SCOPE_ID=default
# Non-secret identifiers used only by db:seed:postgres.
WORKBENCH_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
WORKBENCH_PROJECT_ID=00000000-0000-4000-8000-000000000002

# App-role Neon pooled or direct PostgreSQL connection string.
# Never commit a real value or use a NEXT_PUBLIC_ variable.
DATABASE_URL=

# Absolute server-side path for immutable specification artifacts when using
# PostgreSQL. Use a durable mounted volume; never expose it as NEXT_PUBLIC_.
ARTIFACT_STORE_PATH=/var/lib/ai-dev-harness/artifacts
# P9 runtime evidence uses a separate immutable Object Store. Production only
# accepts `s3`; local development may use `filesystem` with an HTTPS download
# endpoint and a server-only signing key. AWS/R2 credentials come from workload
# identity or Secret injection and are intentionally absent from this file.
ARTIFACT_OBJECT_STORE=filesystem
ARTIFACT_FILESYSTEM_ROOT=/var/lib/ai-dev-harness/run-evidence
ARTIFACT_DOWNLOAD_BASE_URL=https://localhost.invalid/api/internal/artifacts
ARTIFACT_DOWNLOAD_SIGNING_SECRET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_PREFIX=
ARTIFACT_S3_FORCE_PATH_STYLE=false
# Optional non-secret model profile resolved by the server-side Codex CLI.
CODEX_PLANNER_MODEL=

# Optional server-only formal AutoDev atomic Import endpoint. AutoDev 0.4.16
# provides this authenticated interface. Never use NEXT_PUBLIC_.
AUTODEV_QUEUE_IMPORT_URL=
AUTODEV_QUEUE_IMPORT_TOKEN=

# Independent P7 Scheduler/Execution Gateway. Paths must be absolute. The
# network wrapper must enforce the declared deny/allowlist policy; it is never
# an arbitrary shell prefix. Secret names refer to separately injected
# server-side environment values and must not contain values themselves.
AUTODEV_PYTHON=
AUTODEV_PROJECT_CONFIG=
AUTODEV_REPOSITORY_ROOT=
AUTODEV_NETWORK_WRAPPER=
AUTODEV_NETWORK_WRAPPER_ARGS_JSON=[]
AUTODEV_EXECUTION_SECRET_NAMES=
EXECUTION_NODE_ID=
EXECUTION_NODE_NAME=
EXECUTION_NODE_PROVIDER=local
EXECUTION_NODE_CAPABILITIES_JSON=[]
EXECUTION_NODE_CAPACITY=1
EXECUTION_NODE_HEARTBEAT_MS=15000
EXECUTION_LEASE_DURATION_MS=60000
SCHEDULER_SUPERVISOR_ID=
SCHEDULER_INTERVAL_MS=2000
SCHEDULER_ADMISSION_ACTOR_ID=
SCHEDULER_ADMISSION_BATCH_SIZE=10
SCHEDULER_JOB_MAX_ATTEMPTS=3
SCHEDULER_JOB_MAX_RUNTIME_SECONDS=3600
SCHEDULER_JOB_MAX_COST_USD=

# Generic OIDC Authorization Code + PKCE. Values are server-only; generate the
# cookie key with 32 random bytes encoded as base64url. Never use NEXT_PUBLIC_.
OIDC_ISSUER=https://idp.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_COOKIE_SECRET=
OIDC_ALLOWED_RETURN_TO_PATHS=/,/goals,/releases
OIDC_SESSION_TTL_SECONDS=28800
OIDC_TRANSACTION_TTL_SECONDS=600
# P10 independent Goal Verifier. These values are server-only and contain no credentials.
CODEX_GOAL_VERIFIER_MODEL=
GOAL_VERIFIER_IDENTITY=codex-goal-verifier
GOAL_VERIFICATION_COMMANDS_JSON=[]
