# Local-only defaults. Managed environments use the templates under
# config/environments and must select PostgreSQL explicitly.
WORKBENCH_DATA_SOURCE=auto
WORKBENCH_SCOPE_ID=default
# Non-secret identifiers used only by db:seed:postgres.
WORKBENCH_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
WORKBENCH_PROJECT_ID=00000000-0000-4000-8000-000000000002

# App-role Neon pooled or direct PostgreSQL connection string.
# Never commit a real value or use a NEXT_PUBLIC_ variable.
DATABASE_URL=

# Absolute server-side path for immutable specification artifacts when using
# PostgreSQL. Use a durable mounted volume; never expose it as NEXT_PUBLIC_.
ARTIFACT_STORE_PATH=/var/lib/ai-dev-harness/artifacts
# Optional non-secret model profile resolved by the server-side Codex CLI.
CODEX_PLANNER_MODEL=

# Generic OIDC Authorization Code + PKCE. Values are server-only; generate the
# cookie key with 32 random bytes encoded as base64url. Never use NEXT_PUBLIC_.
OIDC_ISSUER=https://idp.example.invalid
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_COOKIE_SECRET=
OIDC_ALLOWED_RETURN_TO_PATHS=/,/goals
OIDC_SESSION_TTL_SECONDS=28800
OIDC_TRANSACTION_TTL_SECONDS=600
